// EBD com Propósito - Database Schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  DIRIGENTE
  VICE_DIRIGENTE
  PROFESSOR
  APOIO
}

enum AttendanceStatus {
  PRESENTE
  FALTA
  FALTA_JUSTIFICADA
  VISITANTE
}

enum ClassAssignmentRole {
  PROFESSOR
  AUXILIAR
}

model User {
  id                String                   @id @default(cuid())
  name              String
  email             String                   @unique
  password          String
  role              Role                     @default(APOIO)
  image             String?
  birthDate         DateTime?
  active            Boolean                  @default(true)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  classId           String?
  class             Class?                   @relation("UserClass", fields: [classId], references: [id])
  justifications    AbsenceJustification[]
  sentNotifications Notification[]           @relation("SentNotifications")
  isGlobalAdmin     Boolean                  @default(false)
  memberships       OrganizationMembership[]

  @@map("users")
}

model Class {
  id            String   @id @default(cuid())
  name          String
  description   String?
  audience      String?
  professor     String?
  dirigente     String?
  viceDirigente String?
  status        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  students          Student[]
  leaders           Leader[]
  lessons           Lesson[]
  attendanceRecords AttendanceRecord[]
  visitors          Visitor[]
  quarterHighlights QuarterHighlight[]
  users             User[]             @relation("UserClass")
  photoAlbums       PhotoAlbum[]
  materials         Material[]

  classStaffAssignments ClassStaffAssignment[]

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@unique([id, organizationId], map: "classes_id_org_key")
  @@map("classes")
}

model Student {
  id             String    @id @default(cuid())
  name           String
  gender         String?
  birthDate      DateTime?
  phone          String?
  address        String?
  guardian       String?
  classId        String
  class          Class     @relation(fields: [classId], references: [id])
  enrollmentDate DateTime  @default(now())
  active         Boolean   @default(true)
  observations   String?
  photo          String?
  baptized       Boolean   @default(false)
  member         Boolean   @default(false)
  newConvert     Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  attendanceItems   AttendanceItem[]
  justifications    AbsenceJustification[]
  visitorsInvited   Visitor[]
  visitorPoints     StudentVisitorPoint[]
  quarterHighlights QuarterHighlight[]
  rewards           Reward[]

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@map("students")
}

model Leader {
  id           String   @id @default(cuid())
  name         String
  role         String // Professor, Dirigente, Vice-Dirigente
  phone        String?
  email        String?
  classId      String?
  class        Class?   @relation(fields: [classId], references: [id])
  startDate    DateTime @default(now())
  observations String?
  photo        String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  attendance LeaderAttendance[]

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@map("leaders")
}

model LeaderAttendance {
  id            String           @id @default(cuid())
  leaderId      String
  leader        Leader           @relation(fields: [leaderId], references: [id])
  date          DateTime
  status        AttendanceStatus
  justification String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([leaderId, date])
  @@map("leader_attendance")
}

model Lesson {
  id          String    @id @default(cuid())
  number      Int
  title       String
  quarter     String
  category    String    @default("Adultos") // Adultos, Jovens, Adolescentes, Crianças
  date        DateTime?
  classId     String?
  class       Class?    @relation(fields: [classId], references: [id])
  teacherName String?
  summary     String?
  bibleText   String?
  image       String?
  status      String    @default("pendente")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@map("lessons")
}

model AttendanceRecord {
  id           String   @id @default(cuid())
  date         DateTime
  classId      String
  class        Class    @relation(fields: [classId], references: [id])
  observations String?
  biblias      Int      @default(0)
  revistas     Int      @default(0)
  ofertas      Decimal  @default(0) @db.Decimal(10, 2)
  outros       Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  items AttendanceItem[]

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@unique([date, classId])
  @@map("attendance_records")
}

model AttendanceItem {
  id           String           @id @default(cuid())
  recordId     String
  record       AttendanceRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student          @relation(fields: [studentId], references: [id])
  status       AttendanceStatus
  observations String?
  createdAt    DateTime         @default(now())

  @@unique([recordId, studentId])
  @@map("attendance_items")
}

model AbsenceJustification {
  id             String   @id @default(cuid())
  studentId      String
  student        Student  @relation(fields: [studentId], references: [id])
  date           DateTime
  reason         String
  observations   String?
  registeredById String?
  registeredBy   User?    @relation(fields: [registeredById], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@map("absence_justifications")
}

model Visitor {
  id           String   @id @default(cuid())
  name         String
  date         DateTime
  classId      String
  class        Class    @relation(fields: [classId], references: [id])
  invitedById  String?
  invitedBy    Student? @relation(fields: [invitedById], references: [id])
  observations String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@map("visitors")
}

model StudentVisitorPoint {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id])
  quarter   String
  points    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, quarter])
  @@map("student_visitor_points")
}

model QuarterHighlight {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id])
  classId   String
  class     Class    @relation(fields: [classId], references: [id])
  quarter   String
  reason    String
  date      DateTime @default(now())
  photo     String?
  type      String   @default("destaque") // destaque, missionario
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@map("quarter_highlights")
}

model Reward {
  id           String    @id @default(cuid())
  studentId    String
  student      Student   @relation(fields: [studentId], references: [id])
  quarter      String
  description  String
  delivered    Boolean   @default(false)
  deliveryDate DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@map("rewards")
}

model Event {
  id          String    @id @default(cuid())
  title       String
  description String?
  date        DateTime
  endDate     DateTime?
  type        String    @default("evento") // aula, evento, comemorativo, aniversario
  allDay      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@map("events")
}

model Settings {
  id             String   @id @default(cuid())
  churchName     String   @default("Igreja")
  logo           String?
  currentQuarter String   @default("2026-Q1")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@map("settings")
}

model Notification {
  id        String    @id @default(cuid())
  title     String
  message   String    @db.Text
  type      String    @default("info") // info, warning, birthday, success
  userId    String? // If null, it's global
  senderId  String? // Who sent the notification
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  expiresAt DateTime?

  sender User?              @relation("SentNotifications", fields: [senderId], references: [id])
  reads  NotificationRead[]

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@map("notifications")
}

model NotificationRead {
  id             String       @id @default(cuid())
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId         String
  readAt         DateTime     @default(now())

  @@unique([notificationId, userId])
  @@map("notification_reads")
}

model PhotoAlbum {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  date        DateTime
  type        String   @default("aula") // aula, evento, outro
  classId     String?
  class       Class?   @relation(fields: [classId], references: [id])
  coverUrl    String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  photos PhotoItem[]

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@map("photo_albums")
}

model PhotoItem {
  id        String     @id @default(cuid())
  albumId   String
  album     PhotoAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)
  url       String
  caption   String?
  createdAt DateTime   @default(now())

  @@map("photo_items")
}

model Material {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  fileUrl     String
  fileName    String
  fileSize    Int
  category    String   @default("Outros") // Revista, Lição, Livro, Outros
  classId     String?
  class       Class?   @relation(fields: [classId], references: [id])
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@map("materials")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships           OrganizationMembership[]
  classes               Class[]
  settings              Settings[]
  students              Student[]
  leaders               Leader[]
  lessons               Lesson[]
  attendanceRecords     AttendanceRecord[]
  absenceJustifications AbsenceJustification[]
  visitors              Visitor[]
  quarterHighlights     QuarterHighlight[]
  rewards               Reward[]
  events                Event[]
  notifications         Notification[]
  photoAlbums           PhotoAlbum[]
  materials             Material[]

  @@map("organizations")
}

model OrganizationMembership {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           Role         @default(APOIO)
  status         String       @default("ACTIVE")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  classStaffAssignments ClassStaffAssignment[]

  @@unique([userId, organizationId])
  @@unique([id, organizationId], map: "memberships_id_org_key")
  @@map("organization_memberships")
}

model ClassStaffAssignment {
  id                       String              @id @default(cuid())
  organizationId           String
  classId                  String
  organizationMembershipId String
  assignmentRole           ClassAssignmentRole @default(PROFESSOR)
  active                   Boolean             @default(true)
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt

  class Class @relation(fields: [classId, organizationId], references: [id, organizationId], onDelete: Cascade, onUpdate: Cascade, map: "csa_class_org_fkey")

  membership OrganizationMembership @relation(fields: [organizationMembershipId, organizationId], references: [id, organizationId], onDelete: Cascade, onUpdate: Cascade, map: "csa_membership_org_fkey")

  @@unique([classId, organizationMembershipId], map: "csa_class_membership_key")
  @@index([organizationId, active], map: "csa_org_active_idx")
  @@index([organizationMembershipId, organizationId, active], map: "csa_member_org_active_idx")
  @@map("class_staff_assignments")
}
